{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackees/mimalloc-pprof/schema/pprof-tax-v1.schema.json",
  "title": "mimalloc-pprof pprof-tax-v1 raw run",
  "description": "Compilation and runtime overhead of the fork's sampled heap profiler: seven build/runtime configurations over a fixed core-throughput-v1 workload subset, measured as six paired comparisons. This root schema describes the raw run artifact; the $defs describe the manifest, one raw sample, the published report section (embedded at latest.json#/pprof_tax), one comparison, and the compact history row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "raw_schema_version",
    "metric_schema_version",
    "mode",
    "run",
    "runner",
    "run_seed",
    "blocks",
    "configuration_manifest_sha256",
    "manifest",
    "topology",
    "cells",
    "block_orders",
    "stress_budget_seconds",
    "samples"
  ],
  "properties": {
    "raw_schema_version": { "const": "pprof-tax-raw-v1" },
    "metric_schema_version": { "const": "pprof-tax-v1" },
    "mode": { "enum": ["full", "smoke"] },
    "run": { "$ref": "raw-run-v1.schema.json#/$defs/run" },
    "runner": { "$ref": "raw-run-v1.schema.json#/$defs/runner" },
    "run_seed": { "type": "integer", "minimum": 1 },
    "blocks": { "type": "integer", "minimum": 1 },
    "configuration_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_cores", "logical_cores"],
      "properties": {
        "physical_cores": { "type": "integer", "minimum": 1 },
        "logical_cores": { "type": "integer", "minimum": 1 }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "thread_point",
          "thread_count",
          "operations_per_worker",
          "warmup_operations_per_worker",
          "calibration_elapsed_ns"
        ],
        "properties": {
          "scenario_id": { "$ref": "#/$defs/scenarioId" },
          "thread_point": { "type": "string", "minLength": 1 },
          "thread_count": { "type": "integer", "minimum": 1 },
          "operations_per_worker": { "type": "integer", "minimum": 1 },
          "warmup_operations_per_worker": { "type": "integer", "minimum": 0 },
          "calibration_elapsed_ns": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "block_orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 7,
        "maxItems": 7,
        "items": { "$ref": "#/$defs/configurationId" }
      }
    },
    "stress_budget_seconds": { "type": "integer", "minimum": 0 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rawSample" }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "configurationId": {
      "enum": [
        "upstream-baseline",
        "fork-pprof-off",
        "fork-pprof-on-stopped",
        "fork-pprof-off-frame-pointers",
        "fork-pprof-sparse",
        "fork-pprof-aggressive",
        "fork-pprof-rate-1-stress"
      ]
    },
    "compiledConfigurationId": {
      "enum": [
        "upstream-baseline",
        "fork-pprof-off",
        "fork-pprof-on",
        "fork-pprof-off-frame-pointers"
      ]
    },
    "comparisonId": {
      "enum": [
        "fork-overlay-tax",
        "instrumentation-tax",
        "frame-pointer-tax",
        "sparse-sampling-tax",
        "aggressive-sampling-tax",
        "rate-1-stress"
      ]
    },
    "scenarioId": {
      "enum": [
        "tiny-fixed-64",
        "small-log-mixed",
        "cross-thread-producer-consumer",
        "thread-churn",
        "representative-mix"
      ]
    },
    "supportStatus": {
      "enum": ["supported", "unsupported", "invalid", "insufficient-paired-blocks"]
    },
    "validityStatus": { "enum": ["valid", "invalid"] },
    "identityProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "allocator_id",
        "allocator_version",
        "source_sha",
        "library_sha256",
        "executable_sha256",
        "pprof_compiled",
        "pprof_enabled"
      ],
      "properties": {
        "configuration_id": { "$ref": "#/$defs/compiledConfigurationId" },
        "allocator_id": { "$ref": "#/$defs/nonempty" },
        "allocator_version": { "$ref": "#/$defs/nonempty" },
        "source_sha": { "$ref": "#/$defs/sha1" },
        "library_sha256": { "$ref": "#/$defs/sha256" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "pprof_compiled": { "type": "boolean" },
        "pprof_enabled": { "const": false }
      }
    },
    "compiledConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_configuration_id",
        "allocator_id",
        "allocator_version",
        "source_sha",
        "pprof_compiled",
        "frame_pointer_policy",
        "cmake_arguments",
        "cmake_cache",
        "c_compiler_identity",
        "linker_identity",
        "static_library_sha256",
        "executable_path",
        "executable_sha256",
        "identity_probe"
      ],
      "properties": {
        "compiled_configuration_id": { "$ref": "#/$defs/compiledConfigurationId" },
        "allocator_id": { "$ref": "#/$defs/nonempty" },
        "allocator_version": { "$ref": "#/$defs/nonempty" },
        "source_sha": { "$ref": "#/$defs/sha1" },
        "pprof_compiled": { "type": "boolean" },
        "frame_pointer_policy": { "enum": ["omitted", "cmake-mi-pprof-implicit", "forced-flag"] },
        "cmake_arguments": { "type": "array", "items": { "type": "string" } },
        "cmake_cache": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "CMAKE_AR", "CMAKE_BUILD_TYPE", "CMAKE_C_COMPILER", "CMAKE_C_FLAGS", "CMAKE_C_FLAGS_RELEASE",
              "CMAKE_EXE_LINKER_FLAGS", "CMAKE_INTERPROCEDURAL_OPTIMIZATION", "CMAKE_STATIC_LINKER_FLAGS",
              "MI_BUILD_SHARED", "MI_BUILD_STATIC", "MI_BUILD_TESTS", "MI_DEBUG_FULL", "MI_DHAT",
              "MI_OPT_ARCH", "MI_OPT_SIMD", "MI_OVERRIDE", "MI_PPROF", "MI_SECURE", "MI_TRACK_ASAN",
              "MI_TRACK_VALGRIND"
            ]
          },
          "additionalProperties": { "type": ["string", "null"] }
        },
        "c_compiler_identity": { "$ref": "#/$defs/nonempty" },
        "linker_identity": { "$ref": "#/$defs/nonempty" },
        "static_library_sha256": { "$ref": "#/$defs/sha256" },
        "executable_path": { "$ref": "#/$defs/nonempty" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "identity_probe": { "$ref": "#/$defs/identityProbe" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema_version",
        "target",
        "fork_source_sha",
        "upstream_source_sha",
        "upstream_archive_sha256",
        "toolchain",
        "environment",
        "compiled_configurations"
      ],
      "properties": {
        "manifest_schema_version": { "const": "pprof-tax-manifest-v1" },
        "target": { "$ref": "#/$defs/nonempty" },
        "fork_source_sha": { "$ref": "#/$defs/sha1" },
        "upstream_source_sha": { "const": "6def7be9458fb8a97b8323af3fb0b0ae04387065" },
        "upstream_archive_sha256": { "$ref": "#/$defs/sha256" },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["c_compiler", "c_compiler_identity", "linker_identity", "cmake", "ninja", "rustc", "cargo"],
          "properties": {
            "c_compiler": { "$ref": "#/$defs/nonempty" },
            "c_compiler_identity": { "$ref": "#/$defs/nonempty" },
            "linker_identity": { "$ref": "#/$defs/nonempty" },
            "cmake": { "$ref": "#/$defs/nonempty" },
            "ninja": { "$ref": "#/$defs/nonempty" },
            "rustc": { "$ref": "#/$defs/nonempty" },
            "cargo": { "$ref": "#/$defs/nonempty" }
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": { "enum": ["CC", "CXX", "AR", "CFLAGS", "LDFLAGS", "RUSTFLAGS", "SOURCE_DATE_EPOCH"] },
          "additionalProperties": { "type": ["string", "null"] }
        },
        "compiled_configurations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/compiledConfiguration" }
        }
      }
    },
    "rawSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "position",
        "configuration_id",
        "compiled_configuration_id",
        "configuration_manifest_sha256",
        "executable_sha256",
        "pprof_compiled",
        "pprof_active",
        "sampling_interval_bytes",
        "frame_pointer_policy",
        "scenario_id",
        "thread_point",
        "thread_count",
        "operations_per_worker",
        "workload_seed",
        "throughput_operations_per_second",
        "elapsed_ns",
        "operation_count",
        "allocation_calls",
        "checksum",
        "allocated_bytes_lower_bound",
        "peak_rss_bytes",
        "end_rss_delta_bytes",
        "profile_path",
        "profile_sha256",
        "profile_size_bytes",
        "sample_count",
        "sampled_bytes",
        "dropped_records",
        "profiler_arena_bytes",
        "interval_confirmed",
        "timed_out",
        "exit_code",
        "validity_status",
        "invalid_reason"
      ],
      "properties": {
        "block_id": { "type": "integer", "minimum": 0 },
        "position": { "type": "integer", "minimum": 0, "maximum": 6 },
        "configuration_id": { "$ref": "#/$defs/configurationId" },
        "compiled_configuration_id": { "$ref": "#/$defs/compiledConfigurationId" },
        "configuration_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "pprof_compiled": { "type": "boolean" },
        "pprof_active": { "type": "boolean" },
        "sampling_interval_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "frame_pointer_policy": { "enum": ["omitted", "cmake-mi-pprof-implicit", "forced-flag"] },
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "thread_point": { "type": "string", "minLength": 1 },
        "thread_count": { "type": "integer", "minimum": 1 },
        "operations_per_worker": { "type": "integer", "minimum": 1 },
        "workload_seed": { "type": "integer", "minimum": 0 },
        "throughput_operations_per_second": { "type": ["number", "null"] },
        "elapsed_ns": { "type": ["integer", "null"], "minimum": 1 },
        "operation_count": { "type": ["integer", "null"], "minimum": 1 },
        "allocation_calls": { "type": ["integer", "null"] },
        "checksum": { "type": ["integer", "null"] },
        "allocated_bytes_lower_bound": { "type": ["integer", "null"] },
        "peak_rss_bytes": { "type": ["integer", "null"] },
        "end_rss_delta_bytes": { "type": ["integer", "null"] },
        "profile_path": { "type": ["string", "null"] },
        "profile_sha256": { "type": ["string", "null"] },
        "profile_size_bytes": { "type": ["integer", "null"] },
        "sample_count": { "type": ["integer", "null"] },
        "sampled_bytes": { "type": ["integer", "null"] },
        "dropped_records": { "type": ["integer", "null"] },
        "profiler_arena_bytes": { "type": ["integer", "null"] },
        "interval_confirmed": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "validity_status": { "$ref": "#/$defs/validityStatus" },
        "invalid_reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "stress-budget-exhausted",
            "timeout",
            "child-failed",
            "interval-not-confirmed",
            "missing-profile",
            "zero-samples-after-crossing-interval",
            "dropped-records-above-threshold"
          ]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "label",
        "numerator_configuration_id",
        "denominator_configuration_id",
        "scenario_id",
        "thread_point",
        "metric_id",
        "badge",
        "support_status",
        "valid_block_count",
        "ratio",
        "ratio_lower",
        "ratio_upper",
        "overhead",
        "overhead_lower",
        "overhead_upper",
        "headline_eligible",
        "reason"
      ],
      "properties": {
        "comparison_id": { "$ref": "#/$defs/comparisonId" },
        "label": { "$ref": "#/$defs/nonempty" },
        "numerator_configuration_id": { "$ref": "#/$defs/configurationId" },
        "denominator_configuration_id": { "$ref": "#/$defs/configurationId" },
        "scenario_id": { "type": ["string", "null"] },
        "thread_point": { "type": ["string", "null"] },
        "metric_id": { "const": "throughput-operations-per-second" },
        "badge": { "enum": ["context", "control", "production-oriented", "aggressive", "stress-only"] },
        "support_status": { "$ref": "#/$defs/supportStatus" },
        "valid_block_count": { "type": "integer", "minimum": 0 },
        "ratio": { "type": ["number", "null"] },
        "ratio_lower": { "type": ["number", "null"] },
        "ratio_upper": { "type": ["number", "null"] },
        "overhead": { "type": ["number", "null"] },
        "overhead_lower": { "type": ["number", "null"] },
        "overhead_upper": { "type": ["number", "null"] },
        "headline_eligible": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "intervals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sparse_bytes", "sparse_rationale", "aggressive_bytes", "stress_bytes"],
      "properties": {
        "sparse_bytes": { "const": 524288 },
        "sparse_rationale": { "$ref": "#/$defs/nonempty" },
        "aggressive_bytes": { "const": 4096 },
        "stress_bytes": { "const": 1 }
      }
    },
    "latencyNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "not-collected" },
        "reason": { "$ref": "#/$defs/nonempty" }
      }
    },
    "configurationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "compiled_configuration_id",
        "role",
        "pprof_compiled",
        "pprof_active",
        "sampling_interval_bytes",
        "frame_pointer_policy",
        "support_status",
        "unsupported_reason",
        "executable_sha256",
        "valid_samples",
        "invalid_samples"
      ],
      "properties": {
        "configuration_id": { "$ref": "#/$defs/configurationId" },
        "compiled_configuration_id": { "$ref": "#/$defs/compiledConfigurationId" },
        "role": { "enum": ["context", "control", "production-oriented", "aggressive", "stress-only"] },
        "pprof_compiled": { "type": "boolean" },
        "pprof_active": { "type": "boolean" },
        "sampling_interval_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "frame_pointer_policy": { "enum": ["omitted", "cmake-mi-pprof-implicit", "forced-flag"] },
        "support_status": { "enum": ["supported", "unsupported"] },
        "unsupported_reason": { "type": ["string", "null"] },
        "executable_sha256": { "type": ["string", "null"] },
        "valid_samples": { "type": "integer", "minimum": 0 },
        "invalid_samples": { "type": "integer", "minimum": 0 }
      }
    },
    "cellSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "thread_point", "thread_count", "operations_per_worker"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "thread_point": { "type": "string", "minLength": 1 },
        "thread_count": { "type": "integer", "minimum": 1 },
        "operations_per_worker": { "type": "integer", "minimum": 1 }
      }
    },
    "activeTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_id",
        "scenario_id",
        "thread_point",
        "valid_runs",
        "invalid_runs",
        "median_sample_count",
        "median_sampled_bytes",
        "max_dropped_records",
        "max_profiler_arena_bytes",
        "median_profile_size_bytes",
        "validity_status",
        "invalid_reasons"
      ],
      "properties": {
        "configuration_id": { "$ref": "#/$defs/configurationId" },
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "thread_point": { "type": "string", "minLength": 1 },
        "valid_runs": { "type": "integer", "minimum": 0 },
        "invalid_runs": { "type": "integer", "minimum": 0 },
        "median_sample_count": { "type": ["integer", "null"] },
        "median_sampled_bytes": { "type": ["integer", "null"] },
        "max_dropped_records": { "type": ["integer", "null"] },
        "max_profiler_arena_bytes": { "type": ["integer", "null"] },
        "median_profile_size_bytes": { "type": ["integer", "null"] },
        "validity_status": { "$ref": "#/$defs/validityStatus" },
        "invalid_reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rssSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "scenario_id", "thread_point", "median_peak_rss_bytes", "median_end_rss_delta_bytes"],
      "properties": {
        "configuration_id": { "$ref": "#/$defs/configurationId" },
        "scenario_id": { "$ref": "#/$defs/scenarioId" },
        "thread_point": { "type": "string", "minLength": 1 },
        "median_peak_rss_bytes": { "type": ["integer", "null"] },
        "median_end_rss_delta_bytes": { "type": ["integer", "null"] }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_schema_version",
        "status",
        "mode",
        "metric_comparison_key",
        "run",
        "runner",
        "run_seed",
        "blocks",
        "minimum_paired_blocks",
        "hosted_runner_scope",
        "configuration_manifest_sha256",
        "raw_artifact_sha256",
        "raw_artifact_name",
        "fork_source_sha",
        "upstream_source_sha",
        "intervals",
        "configurations",
        "cells",
        "comparisons",
        "cell_comparisons",
        "headline",
        "active_telemetry",
        "rss_summaries",
        "latency"
      ],
      "properties": {
        "metric_schema_version": { "const": "pprof-tax-v1" },
        "status": { "const": "valid" },
        "mode": { "const": "full" },
        "metric_comparison_key": { "$ref": "#/$defs/sha256" },
        "run": { "$ref": "raw-run-v1.schema.json#/$defs/run" },
        "runner": { "$ref": "raw-run-v1.schema.json#/$defs/runner" },
        "run_seed": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "integer", "minimum": 15 },
        "minimum_paired_blocks": { "const": 15 },
        "hosted_runner_scope": { "$ref": "#/$defs/nonempty" },
        "configuration_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "raw_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "raw_artifact_name": { "$ref": "#/$defs/nonempty" },
        "fork_source_sha": { "$ref": "#/$defs/sha1" },
        "upstream_source_sha": { "const": "6def7be9458fb8a97b8323af3fb0b0ae04387065" },
        "intervals": { "$ref": "#/$defs/intervals" },
        "configurations": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/configurationSummary" } },
        "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cellSummary" } },
        "comparisons": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/comparison" } },
        "cell_comparisons": { "type": "array", "items": { "$ref": "#/$defs/comparison" } },
        "headline": { "$ref": "#/$defs/comparison" },
        "active_telemetry": { "type": "array", "items": { "$ref": "#/$defs/activeTelemetry" } },
        "rss_summaries": { "type": "array", "items": { "$ref": "#/$defs/rssSummary" } },
        "latency": { "$ref": "#/$defs/latencyNote" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_schema_version",
        "status",
        "mode",
        "metric_comparison_key",
        "run",
        "runner_fingerprint_sha256",
        "run_seed",
        "blocks",
        "minimum_paired_blocks",
        "hosted_runner_scope",
        "configuration_manifest_sha256",
        "raw_artifact_sha256",
        "raw_artifact_name",
        "fork_source_sha",
        "upstream_source_sha",
        "intervals",
        "comparisons",
        "headline",
        "latency"
      ],
      "properties": {
        "metric_schema_version": { "const": "pprof-tax-v1" },
        "status": { "const": "valid" },
        "mode": { "const": "full" },
        "metric_comparison_key": { "$ref": "#/$defs/sha256" },
        "run": { "$ref": "raw-run-v1.schema.json#/$defs/run" },
        "runner_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "run_seed": { "type": "integer", "minimum": 1 },
        "blocks": { "type": "integer", "minimum": 15 },
        "minimum_paired_blocks": { "const": 15 },
        "hosted_runner_scope": { "$ref": "#/$defs/nonempty" },
        "configuration_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "raw_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "raw_artifact_name": { "$ref": "#/$defs/nonempty" },
        "fork_source_sha": { "$ref": "#/$defs/sha1" },
        "upstream_source_sha": { "const": "6def7be9458fb8a97b8323af3fb0b0ae04387065" },
        "intervals": { "$ref": "#/$defs/intervals" },
        "comparisons": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/comparison" } },
        "headline": { "$ref": "#/$defs/comparison" },
        "latency": { "$ref": "#/$defs/latencyNote" }
      }
    }
  }
}
