{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zackees/mimalloc-pprof/schema/raw-run-v1.schema.json",
  "title": "mimalloc-pprof publication raw run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_version", "run_kind", "execution_mode", "run_seed", "run", "runner", "allocator_lock_sha256", "allocators", "calibrations", "samples"],
  "properties": {
    "schema_version": { "const": "benchmark-raw-v1" },
    "suite_version": { "const": "core-throughput-v1" },
    "run_kind": { "const": "headline" },
    "execution_mode": { "const": "normal" },
    "run_seed": { "type": "integer", "minimum": 1 },
    "run": { "$ref": "#/$defs/run" },
    "runner": { "$ref": "#/$defs/runner" },
    "allocator_lock_sha256": { "$ref": "#/$defs/sha256" },
    "allocators": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/allocator" } },
    "calibrations": { "type": "array", "minItems": 30, "maxItems": 30, "items": { "$ref": "#/$defs/calibration" } },
    "samples": { "type": "array", "minItems": 2250, "items": { "$ref": "#/$defs/sample" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonempty": { "type": "string", "minLength": 1 },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["source_repository", "source_sha", "source_ref", "run_origin", "run_id", "run_attempt", "generated_at_utc"],
      "properties": {
        "source_repository": { "const": "https://github.com/zackees/mimalloc-pprof" },
        "source_sha": { "$ref": "#/$defs/sha" },
        "source_ref": { "$ref": "#/$defs/nonempty" },
        "run_origin": { "enum": ["github-actions", "local"] },
        "run_id": { "$ref": "#/$defs/nonempty" },
        "run_attempt": { "type": "integer", "minimum": 1 },
        "generated_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "affinity": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "logical_cpu_ids"],
      "properties": {
        "policy": { "enum": ["unrestricted", "pinned"] },
        "logical_cpu_ids": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "power": {
      "type": "object", "additionalProperties": false,
      "required": ["governor", "boost", "frequency_policy"],
      "properties": {
        "governor": { "$ref": "#/$defs/nonempty" },
        "boost": { "$ref": "#/$defs/nonempty" },
        "frequency_policy": { "$ref": "#/$defs/nonempty" }
      }
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_class", "stable_host_id", "fingerprint_sha256", "cpu_model", "os", "os_image", "os_version", "kernel", "architecture", "physical_cores", "logical_cores", "target", "rustc", "affinity", "power"],
      "properties": {
        "runner_class": { "enum": ["github-hosted", "self-hosted-informational", "stable-host"] },
        "stable_host_id": { "type": "string" },
        "fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "cpu_model": { "$ref": "#/$defs/nonempty" },
        "os": { "$ref": "#/$defs/nonempty" },
        "os_image": { "$ref": "#/$defs/nonempty" },
        "os_version": { "$ref": "#/$defs/nonempty" },
        "kernel": { "$ref": "#/$defs/nonempty" },
        "architecture": { "$ref": "#/$defs/nonempty" },
        "physical_cores": { "type": "integer", "minimum": 1 },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "target": { "const": "x86_64-unknown-linux-gnu" },
        "rustc": { "$ref": "#/$defs/nonempty" },
        "affinity": { "$ref": "#/$defs/affinity" },
        "power": { "$ref": "#/$defs/power" }
      }
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": { "file": { "$ref": "#/$defs/nonempty" }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "featureOptions": {
      "type": "object", "additionalProperties": false,
      "required": ["pprof_compiled", "pprof_runtime", "memory_events_compiled", "memory_events_runtime", "frame_pointers", "opt_arch", "opt_simd"],
      "properties": {
        "pprof_compiled": { "$ref": "#/$defs/featureState" },
        "pprof_runtime": { "$ref": "#/$defs/featureState" },
        "memory_events_compiled": { "$ref": "#/$defs/featureState" },
        "memory_events_runtime": { "$ref": "#/$defs/featureState" },
        "frame_pointers": { "$ref": "#/$defs/featureState" },
        "opt_arch": { "$ref": "#/$defs/featureState" },
        "opt_simd": { "$ref": "#/$defs/featureState" }
      }
    },
    "featureState": { "enum": ["enabled", "disabled", "not-applicable"] },
    "allocator": {
      "type": "object", "additionalProperties": false,
      "required": ["allocator_id", "allocator_version", "source_kind", "canonical_repository", "source_sha", "source_archive_url", "source_archive_sha256", "source_tree_sha256", "source_patches", "build_system", "build_commands", "build_flags", "compiler", "linker", "static_library_sha256", "child_binary_sha256", "options"],
      "properties": {
        "allocator_id": { "enum": ["tcmalloc", "jemalloc", "upstream-mimalloc", "bun-mimalloc", "mimalloc-pprof"] },
        "allocator_version": { "$ref": "#/$defs/nonempty" },
        "source_kind": { "enum": ["archive", "checkout"] },
        "canonical_repository": { "type": "string", "format": "uri" },
        "source_sha": { "$ref": "#/$defs/sha" },
        "source_archive_url": { "$ref": "#/$defs/nonempty" },
        "source_archive_sha256": { "type": "string", "anyOf": [{ "$ref": "#/$defs/sha256" }, { "const": "not-applicable" }] },
        "source_tree_sha256": { "$ref": "#/$defs/sha256" },
        "source_patches": { "type": "array", "items": { "$ref": "#/$defs/patch" } },
        "build_system": { "$ref": "#/$defs/nonempty" },
        "build_commands": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" } } },
        "build_flags": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "compiler": { "$ref": "#/$defs/nonempty" },
        "linker": { "$ref": "#/$defs/nonempty" },
        "static_library_sha256": { "$ref": "#/$defs/sha256" },
        "child_binary_sha256": { "$ref": "#/$defs/sha256" },
        "options": { "$ref": "#/$defs/featureOptions" }
      }
    },
    "calibration": {
      "type": "object", "additionalProperties": false,
      "required": ["scenario_id", "thread_point", "thread_count", "transactions_per_worker", "warmup_transactions_per_worker", "operation_count", "elapsed_ns"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/nonempty" },
        "thread_point": { "enum": ["1", "2", "physical-core", "2x-logical"] },
        "thread_count": { "type": "integer", "minimum": 1 },
        "transactions_per_worker": { "type": "integer", "minimum": 1 },
        "warmup_transactions_per_worker": { "type": "integer", "minimum": 1 },
        "operation_count": { "type": "integer", "minimum": 1 },
        "elapsed_ns": { "type": "integer", "minimum": 500000000, "maximum": 2000000000 }
      }
    },
    "sampleRunner": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "architecture", "physical_cores", "logical_cores"],
      "properties": {
        "os": { "$ref": "#/$defs/nonempty" }, "architecture": { "$ref": "#/$defs/nonempty" },
        "physical_cores": { "type": "integer", "minimum": 1 }, "logical_cores": { "type": "integer", "minimum": 1 }
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["rustc", "target", "compiler", "linker"],
      "properties": { "rustc": { "$ref": "#/$defs/nonempty" }, "target": { "$ref": "#/$defs/nonempty" }, "compiler": { "$ref": "#/$defs/nonempty" }, "linker": { "$ref": "#/$defs/nonempty" } }
    },
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "suite_version", "run_kind", "execution_mode", "run_seed", "block_id", "ordinal", "workload_seed", "allocator_id", "allocator_version", "allocator_source_sha", "allocator_library_sha256", "child_binary_sha256", "scenario_id", "scenario_version", "thread_point", "thread_count", "operation_unit", "operation_count", "requested_transactions", "completed_transactions", "allocation_calls", "calloc_calls", "aligned_allocation_calls", "free_calls", "realloc_calls", "setup_ns", "warmup_ns", "elapsed_ns", "teardown_ns", "throughput_operations_per_second", "checksum", "peak_live_requested_bytes", "timed_out", "crashed", "exit_code", "signal", "runner", "toolchain", "reproduction_command"],
      "properties": {
        "schema_version": { "const": "benchmark-raw-v1" }, "suite_version": { "const": "core-throughput-v1" }, "run_kind": { "const": "headline" }, "execution_mode": { "const": "normal" },
        "run_seed": { "type": "integer", "minimum": 1 }, "block_id": { "type": "integer", "minimum": 0 }, "ordinal": { "type": "integer", "minimum": 0, "maximum": 3 }, "workload_seed": { "type": "integer", "minimum": 0 },
        "allocator_id": { "enum": ["tcmalloc", "jemalloc", "upstream-mimalloc", "bun-mimalloc", "mimalloc-pprof"] }, "allocator_version": { "$ref": "#/$defs/nonempty" }, "allocator_source_sha": { "$ref": "#/$defs/sha" }, "allocator_library_sha256": { "$ref": "#/$defs/sha256" }, "child_binary_sha256": { "$ref": "#/$defs/sha256" },
        "scenario_id": { "$ref": "#/$defs/nonempty" }, "scenario_version": { "const": "core-throughput-v1" }, "thread_point": { "enum": ["1", "2", "physical-core", "2x-logical"] }, "thread_count": { "type": "integer", "minimum": 1 }, "operation_unit": { "$ref": "#/$defs/nonempty" },
        "operation_count": { "type": "integer", "minimum": 1 }, "requested_transactions": { "type": "integer", "minimum": 1 }, "completed_transactions": { "type": "integer", "minimum": 1 },
        "allocation_calls": { "type": "integer", "minimum": 0 }, "calloc_calls": { "type": "integer", "minimum": 0 }, "aligned_allocation_calls": { "type": "integer", "minimum": 0 }, "free_calls": { "type": "integer", "minimum": 1 }, "realloc_calls": { "type": "integer", "minimum": 0 },
        "setup_ns": { "type": "integer", "minimum": 0 }, "warmup_ns": { "type": "integer", "minimum": 1 }, "elapsed_ns": { "type": "integer", "minimum": 1 }, "teardown_ns": { "type": "integer", "minimum": 0 },
        "throughput_operations_per_second": { "type": "number", "exclusiveMinimum": 0 }, "checksum": { "type": "integer", "minimum": 1 }, "peak_live_requested_bytes": { "type": "integer", "minimum": 1 },
        "timed_out": { "const": false }, "crashed": { "const": false }, "exit_code": { "const": 0 }, "signal": { "type": "null" },
        "runner": { "$ref": "#/$defs/sampleRunner" }, "toolchain": { "$ref": "#/$defs/toolchain" }, "reproduction_command": { "$ref": "#/$defs/nonempty" }
      }
    }
  }
}
