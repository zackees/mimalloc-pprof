{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zackees.github.io/mimalloc-pprof/schema/scaling-v1.schema.json",
  "title": "throughput-scaling-sparse-v1 metric report",
  "description": "Sparse thread-scaling sweep: four seeded random allocation patterns measured at literal worker counts 1/4/16 for five allocators. This is an explicit coverage-mode downgrade of the dense scaling protocol: three blocks per cell, median with min/max, and deliberately no bootstrap intervals or noise gating. Every consumer must surface the rigor label.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_schema_version",
    "status",
    "invalid_reason",
    "metric_comparison_key",
    "run",
    "runner",
    "topology",
    "direction",
    "informational",
    "rigor_label",
    "thread_points",
    "patterns",
    "methodology",
    "cell_summaries",
    "raw_samples"
  ],
  "properties": {
    "metric_schema_version": {
      "const": "throughput-scaling-sparse-v1"
    },
    "status": {
      "enum": ["complete", "invalid"],
      "description": "Only a complete report may replace the pending scaling panel."
    },
    "invalid_reason": {
      "type": ["string", "null"],
      "description": "Non-null only when status is invalid; absence of a value is never an implicit pass."
    },
    "metric_comparison_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Chart lines may connect only across identical keys. Inputs include the protocol version, thread points, block count, pattern definitions, runner fingerprint, affinity policy, allowed CPU count, allocator lock digest, allocator source pins, and the frozen per-cell operation counts."
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "runner": {
      "type": "object",
      "description": "The same publication runner record the core throughput report carries."
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_cores", "logical_cores", "allowed_logical_cpus", "affinity_policy"],
      "properties": {
        "physical_cores": { "type": "integer", "minimum": 1 },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "allowed_logical_cpus": {
          "type": "integer",
          "minimum": 1,
          "description": "Denominator for the oversubscription factor. Recorded as metadata only: thread points are literal and are never resolved from topology."
        },
        "affinity_policy": {
          "type": "string",
          "description": "Recorded, not enforced. This protocol pins nothing."
        }
      }
    },
    "direction": {
      "const": "higher-is-better"
    },
    "informational": {
      "const": true,
      "description": "Hosted-runner measurements are informational and never an acceptance gate."
    },
    "rigor_label": {
      "const": "coverage mode - reduced statistical rigor (3 blocks)",
      "description": "Mandatory on the panel, in index.html, and in the metric metadata."
    },
    "thread_points": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "minItems": 3,
      "maxItems": 3,
      "description": "Exactly [1, 4, 16]. Literal worker counts, not topology-resolved. A different set requires a new metric version."
    },
    "patterns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern",
          "description",
          "min_size_bytes",
          "max_size_bytes",
          "live_set_capacity",
          "cross_thread"
        ],
        "properties": {
          "pattern": {
            "enum": [
              "sparse-tiny-hot",
              "sparse-mixed-general",
              "sparse-large-buffers",
              "sparse-cross-thread"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "min_size_bytes": { "type": "integer", "minimum": 1 },
          "max_size_bytes": { "type": "integer", "minimum": 1 },
          "live_set_capacity": { "type": "integer", "minimum": 1 },
          "cross_thread": { "type": "boolean" }
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rigor",
        "blocks_per_cell",
        "aggregation",
        "operation_stream",
        "seed_chain",
        "pairing",
        "work_normalization",
        "oversubscription",
        "cross_thread_backpressure",
        "statistics_omitted"
      ],
      "properties": {
        "rigor": { "type": "string", "minLength": 1 },
        "blocks_per_cell": { "const": 3 },
        "aggregation": { "type": "string", "minLength": 1 },
        "operation_stream": { "type": "string", "minLength": 1 },
        "seed_chain": {
          "type": "string",
          "minLength": 1,
          "description": "splitmix64 chain over (run seed, pattern tag, thread count, block, worker). The allocator is deliberately absent, which is what makes a paired block replay one identical stream for all five allocators."
        },
        "pairing": { "type": "string", "minLength": 1 },
        "work_normalization": { "type": "string", "minLength": 1 },
        "oversubscription": { "type": "string", "minLength": 1 },
        "cross_thread_backpressure": {
          "type": "string",
          "minLength": 1,
          "description": "Bounded per-worker mailbox; a producer facing a full mailbox frees the block itself rather than blocking."
        },
        "statistics_omitted": { "type": "string", "minLength": 1 }
      }
    },
    "cell_summaries": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "description": "4 patterns x 3 thread points x 5 allocators.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern",
          "thread_count",
          "oversubscription_factor",
          "oversubscribed",
          "allocator_id",
          "block_count",
          "median_throughput",
          "min_throughput",
          "max_throughput",
          "speedup_vs_single_worker"
        ],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "thread_count": { "type": "integer", "minimum": 1 },
          "oversubscription_factor": { "type": "number", "exclusiveMinimum": 0 },
          "oversubscribed": {
            "type": "boolean",
            "description": "True exactly when the factor exceeds 1.0. Oversubscribed points are honest contention data, never core scaling."
          },
          "allocator_id": {
            "enum": [
            "tcmalloc",
            "jemalloc",
            "upstream-mimalloc",
            "bun-mimalloc",
            "mimalloc-pprof"
          ]
          },
          "block_count": { "const": 3 },
          "median_throughput": { "type": "number", "exclusiveMinimum": 0 },
          "min_throughput": { "type": "number", "exclusiveMinimum": 0 },
          "max_throughput": { "type": "number", "exclusiveMinimum": 0 },
          "speedup_vs_single_worker": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Median at this point divided by the same allocator's median at one worker for the same pattern."
          }
        }
      }
    },
    "raw_samples": {
      "type": "array",
      "minItems": 180,
      "maxItems": 180,
      "description": "Every measured block is retained, not only summaries: 60 cells x 3 blocks.",
      "items": { "$ref": "#/$defs/rawSample" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_sha",
        "source_ref",
        "run_origin",
        "run_id",
        "run_attempt",
        "generated_at_utc"
      ],
      "properties": {
        "source_repository": { "type": "string" },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_ref": { "type": "string" },
        "run_origin": { "enum": ["github-actions", "local"] },
        "run_id": { "type": "string", "minLength": 1 },
        "run_attempt": { "type": "integer", "minimum": 1 },
        "generated_at_utc": { "type": "string" }
      }
    },
    "rawSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_schema_version",
        "block_id",
        "ordinal",
        "pattern",
        "thread_count",
        "allocator_id",
        "allocator_source_sha",
        "child_binary_sha256",
        "operations_per_worker",
        "reproduction_command",
        "response"
      ],
      "properties": {
        "metric_schema_version": { "const": "throughput-scaling-sparse-v1" },
        "block_id": { "type": "integer", "minimum": 0 },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Position within the rotated, near-balanced paired block."
        },
        "pattern": { "type": "string", "minLength": 1 },
        "thread_count": { "type": "integer", "minimum": 1 },
        "allocator_id": {
          "enum": [
            "tcmalloc",
            "jemalloc",
            "upstream-mimalloc",
            "bun-mimalloc",
            "mimalloc-pprof"
          ]
        },
        "allocator_source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "child_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "operations_per_worker": {
          "type": "integer",
          "minimum": 1,
          "description": "Frozen across all five allocators at a given (pattern, thread point); total work scales with worker count."
        },
        "reproduction_command": {
          "type": "string",
          "minLength": 1,
          "description": "Replays this exact child from the request JSON retained in the raw artifact."
        },
        "response": { "$ref": "#/$defs/childResponse" }
      }
    },
    "childResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "metric_schema_version",
        "allocator_id",
        "thread_count",
        "alloc_calls",
        "realloc_calls",
        "free_calls",
        "operation_count",
        "checksum",
        "remote_free_calls",
        "producer_fallback_frees",
        "setup_ns",
        "warmup_ns",
        "elapsed_ns",
        "teardown_ns",
        "throughput_operations_per_second"
      ],
      "properties": {
        "protocol_version": { "const": "throughput-scaling-sparse-child-v1" },
        "metric_schema_version": { "const": "throughput-scaling-sparse-v1" },
        "allocator_id": { "type": "string", "minLength": 1 },
        "thread_count": { "type": "integer", "minimum": 1 },
        "alloc_calls": { "type": "integer", "minimum": 1 },
        "realloc_calls": { "type": "integer", "minimum": 0 },
        "free_calls": { "type": "integer", "minimum": 1 },
        "operation_count": { "type": "integer", "minimum": 1 },
        "checksum": {
          "type": "integer",
          "description": "Order-independent wrapping sum of per-allocation touch contributions. Commutative by construction so the cross-thread pattern, whose completion interleaving is not fixed, still has an exact oracle."
        },
        "remote_free_calls": {
          "type": "integer",
          "minimum": 0,
          "description": "Blocks freed by a worker other than the producer. Zero for every non-cross-thread pattern."
        },
        "producer_fallback_frees": {
          "type": "integer",
          "minimum": 0,
          "description": "Handoffs the producer freed itself because the target mailbox was full. Published so backpressure is visible rather than hidden."
        },
        "setup_ns": { "type": "integer", "minimum": 1 },
        "warmup_ns": { "type": "integer", "minimum": 0 },
        "elapsed_ns": { "type": "integer", "minimum": 1 },
        "teardown_ns": { "type": "integer", "minimum": 1 },
        "throughput_operations_per_second": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
